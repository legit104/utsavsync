# Copy to .env. Required: Supabase email/password account settings (publishable key only).
# For same-Wi-Fi testing from another device, replace localhost with the team laptop's IPv4 address.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key