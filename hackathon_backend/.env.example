# Copy to .env. Everything is optional: with nothing set, the engine runs in memory with login off.
SUPABASE_URL=https://your-project.supabase.co
# Backend-only key used to write the decision log and SWM tasks. Never put this in the React app.
SUPABASE_SERVICE_KEY=your-service-role-key
# Public anon key, used to check login tokens (the React app uses this same key).
SUPABASE_ANON_KEY=your-anon-key
# off = no login checks (development). supabase = require a Supabase login on protected endpoints.
AUTH_MODE=off
# Comma-separated origins allowed to call the API (your React dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend-only signing secret; generate a random 48-byte token with Python.
VOLUNTEER_SESSION_SECRET=replace-with-a-random-secret

